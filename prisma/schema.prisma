generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum Hari {
  senin
  selasa
  rabu
  kamis
  jumat
  sabtu
  minggu
}

enum Jenis_Obat {
  tablet
  kapsul
  kaplet
}

enum MetodeBayar {
  cash
  qris
}

// MODELS
model Dokter {
  id            String   @id @default(uuid())
  nama          String
  spesialis     String
  jenis_kelamin String
  handphone     String
  alamat        String
  status        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jadwal_dokter Jadwal_Dokter[]
}

model Jadwal_Dokter {
  id            String   @id @default(uuid())
  dokterId      String
  hari          Hari
  jam_mulai     String
  jam_selesai   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dokter        Dokter   @relation(fields: [dokterId], references: [id])
}

model Admin {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Pasien {
  id            String   @id @default(uuid())
  nama          String
  nik           String
  jenis_kelamin String
  keluhan       String
  createdAt     DateTime @default(now())

  antrian       Antrian[]
}

model Antrian {
  id            String   @id @default(uuid())
  tanggal       DateTime
  prefix        String @default("U")
  nomor         Int
  status        Boolean
  pasien_id      String
  
  pasien        Pasien   @relation(fields: [pasien_id], references: [id])
}

model Obat {
  id            String     @id @default(uuid())
  nama          String
  jenis         Jenis_Obat
  harga         Int
  status        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Pembayaran {
  id             String        @id @default(uuid())
  pasien         String
  biaya_layanan  Int
  jumlah_bayar   Int
  kembalian      Int?
  metode         MetodeBayar
  sub_total      Int
  total          Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  detail_obat    DetailObatPembayaran[]
}

model DetailObatPembayaran {
  id            String      @id @default(uuid())
  pembayaranId  String
  obatId        String
  nama          String
  harga         Int
  qty           Int
  total         Int

  pembayaran    Pembayaran  @relation(fields: [pembayaranId], references: [id])
}