model Pasien {
  id            String   @id @default(uuid())
  nama          String
  nik           String
  jenis_kelamin String
  keluhan       String
  createdAt     DateTime @default(now())

  antrian       Antrian[]
}

model Antrian {
  id        String   @id @default(uuid())
  tanggal   DateTime
  prefix    String   @default("U")
  nomor     Int
  status    Boolean
  pasien_id String

  pasien    Pasien   @relation(fields: [pasien_id], references: [id])
}
